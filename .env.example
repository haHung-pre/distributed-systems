# ---------------------------------------------------------------------------
# CoEdit-DS sample configuration.  Copy to `.env` and change every secret.
# `.env` is git-ignored and MUST NOT be committed (§4.5).
# ---------------------------------------------------------------------------

# --- secrets (CHANGE THESE) ---
COEDIT_JWT_SECRET=replace-with-64-random-hex-chars
COEDIT_INTERNAL_KEY=replace-with-another-random-string

# --- service endpoints ---
DIRECTORY_URL=http://127.0.0.1:7000
STORAGE_URL=http://127.0.0.1:7100
DIRECTORY_PORT=7000
STORAGE_PORT=7100
GATEWAY_PORT=8080

# --- data ---
COEDIT_DATA_DIR=./data

# --- failure detection / leases (ms) ---
LEASE_TTL_MS=6000
HEARTBEAT_MS=2000
WS_PING_MS=5000
WS_PONG_TIMEOUT_MS=12000

# --- durability ---
SNAPSHOT_EVERY_OPS=200
PERSIST_BATCH_MS=250

# --- limits / hardening ---
MAX_BODY_BYTES=1048576
MAX_OPS_PER_MESSAGE=512
MAX_DOC_CHARS=200000
RATE_LIMIT_OPS_PER_SEC=2000

# --- logging: info|debug|warn|error ; LOG_FORMAT=json for machine-readable ---
LOG_LEVEL=info
LOG_FORMAT=pretty

# --- fault injection (used by scripts/chaos.sh; keep 0 in normal runs) ---
CHAOS_DROP_OUT=0
CHAOS_DUPLICATE=0
CHAOS_DELAY_MS=0
CHAOS_REORDER=0
